// =====================================================================
// Visit.gs — 내원 정보 기준정보 시딩 (VISIT_*)
//
// - 05_시술의 내원경로 / 세부 / 방문유형 드롭다운 목록을
//   14_기준정보에 구분 3종으로 시딩한다 (별도 시트 없음)
// - 출처: 비올라셀_상담매출통계(신규) "기준값" 탭 (2026-08-20 추출)
// - 세부는 내원경로 종속: 비고에 "경로=국내" / "경로=해외" /
//   "경로=국내,직원" 메타를 넣는다. 프론트 필터링과
//   서버 재검증(PROC_세부경로맵_)이 모두 이 메타를 읽는다
// - ★ H003 전용 시딩. 전 병원 일괄 시딩 금지 (인수인계 §0-1)
// - 반복 실행 안전: 이미 있는 병원ID+구분+값 조합은 건너뛴다
// - 사전 조건: Base.gs의 BASE_구분목록 배열에
//   '내원경로', '세부', '방문유형' 이 추가돼 있어야
//   관리 화면(BASE_add)에서 항목 추가가 가능하다 (시딩 자체는 무관)
// =====================================================================


var VISIT_시딩병원 = 'H003';

// [구분, 값, 비고] — 기준값 탭 열 순서 그대로
var VISIT_시딩목록 = [

  // ---------------- 내원경로 ----------------
  ['내원경로', '국내', ''],
  ['내원경로', '해외', ''],
  ['내원경로', '직원', ''],

  // ---------------- 세부 (해외 채널) ----------------
  ['세부', '해외S/S', '경로=해외'],
  ['세부', '제너', '경로=해외'],
  ['세부', 'LK글로벌', '경로=해외'],
  ['세부', '알리다랩', '경로=해외'],
  ['세부', '리부트', '경로=해외'],
  ['세부', '원내해외', '경로=해외'],
  ['세부', '어드바이스', '경로=해외'],

  // ---------------- 세부 (국내 채널) ----------------
  ['세부', '직원지인', '경로=국내'],
  ['세부', '윤플', '경로=국내'],
  ['세부', '체험단', '경로=국내'],
  ['세부', '바비톡', '경로=국내'],
  ['세부', '강남언니', '경로=국내'],
  ['세부', '여신티켓', '경로=국내'],
  ['세부', '워크인', '경로=국내'],
  ['세부', '블루', '경로=국내'],

  // ---------------- 세부 (채널 없음 — 국내·직원 공용) ----------------
  ['세부', '-', '경로=국내,직원'],

  // ---------------- 방문유형 ----------------
  ['방문유형', '초진', ''],
  ['방문유형', '재진', ''],
  ['방문유형', '재상담', ''],
  ['방문유형', '소개', '']
];


// =====================================================================
// 시딩 실행 (편집기에서 수동 실행, Logger 확인)
// - H003에 없는 항목만 추가한다. 반복 실행 안전
// =====================================================================

function VISIT_기준정보시딩_H003() {

  Logger.log('=== 내원 기준정보 시딩 시작 (H003 전용) ===');

  var 기존 = {};

  DB_findWhere('기준정보', { 병원ID: VISIT_시딩병원 }).forEach(function(row) {
    기존[String(row['구분']) + '|' + String(row['값']).trim()] = true;
  });

  var 추가대상 = VISIT_시딩목록.filter(function(항목) {
    return !기존[항목[0] + '|' + 항목[1]];
  });

  if (추가대상.length === 0) {
    Logger.log('추가할 항목 없음 (이미 시딩됨). 변경 없음.');
    Logger.log('=== 내원 기준정보 시딩 종료 ===');
    return;
  }

  var ID목록 = BASE_새ID목록_(추가대상.length);
  var 지금 = new Date();

  var 저장목록 = 추가대상.map(function(항목, i) {
    return {
      기준ID: ID목록[i],
      병원ID: VISIT_시딩병원,
      구분: 항목[0],
      값: 항목[1],
      비고: 항목[2],
      사용여부: true,
      등록일시: 지금,
      수정일시: 지금
    };
  });

  DB_insertMany('기준정보', 저장목록);

  var 건수 = { 내원경로: 0, 세부: 0, 방문유형: 0 };
  저장목록.forEach(function(r) { 건수[r.구분]++; });

  Logger.log('시딩 완료: 총 ' + 저장목록.length + '건 추가 — ' +
    '내원경로 ' + 건수.내원경로 + ' / 세부 ' + 건수.세부 +
    ' / 방문유형 ' + 건수.방문유형);
  Logger.log('=== 내원 기준정보 시딩 종료 ===');
}


// =====================================================================
// 시딩 확인 테스트 (편집기에서 수동 실행, Logger 확인)
// - H003의 구분별 건수와 세부 경로 메타 파싱을 검사한다
// - 데이터를 변경하지 않는다 (읽기 전용)
// =====================================================================

function test_VISIT_시딩확인() {

  Logger.log('=== 내원 기준정보 시딩 확인 시작 ===');

  var rows = DB_findWhere('기준정보', { 병원ID: VISIT_시딩병원 });

  var 건수 = { 내원경로: 0, 세부: 0, 방문유형: 0 };
  var 세부경로 = { 국내: 0, 해외: 0, 직원: 0, 없음: 0 };

  rows.forEach(function(row) {

    var 구분 = String(row['구분']);

    if (건수[구분] === undefined) {
      return;
    }

    건수[구분]++;

    if (구분 === '세부') {

      var m = String(row['비고'] || '').match(/경로\s*=\s*([^;]*)/);

      if (!m) {
        세부경로.없음++;
        return;
      }

      m[1].split(',').forEach(function(p) {
        var 경로 = p.trim();
        if (세부경로[경로] !== undefined) {
          세부경로[경로]++;
        }
      });
    }
  });

  Logger.log('1. 구분별 건수: 내원경로 ' + 건수.내원경로 + '(3이어야 정상) / ' +
    '세부 ' + 건수.세부 + '(16이어야 정상) / ' +
    '방문유형 ' + 건수.방문유형 + '(4여야 정상)');

  Logger.log('2. 세부 경로 메타: 국내 ' + 세부경로.국내 + '(9여야 정상) / ' +
    '해외 ' + 세부경로.해외 + '(7이어야 정상) / ' +
    '직원 ' + 세부경로.직원 + '(1이어야 정상) / ' +
    '메타없음 ' + 세부경로.없음 + '(0이어야 정상)');

  var 검증 = BASE_값목록_(VISIT_시딩병원, '내원경로');

  Logger.log('3. BASE_값목록_ 연동: 내원경로 ' + JSON.stringify(검증));

  Logger.log('=== 내원 기준정보 시딩 확인 종료 ===');
}