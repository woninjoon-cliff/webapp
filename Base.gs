    ') = 총 ' + 새행.length + '건'
  );
}


// =====================================================================
// 통합 테스트 (편집기에서 수동 실행, Logger 확인)
// 추가 → 중복 차단 확인 → 이름변경 → 사용중지 → 목록 제외 확인
// → 테스트 행 시트에서 직접 삭제(원복)
// =====================================================================

function test_BASE_전체흐름() {

  Logger.log('=== 기준정보 통합 테스트 시작 ===');

  var token = AUTH_createSession({
    사용자ID: 'U000003',
    병원ID: 'H003',
    아이디: 'joon',
    이름: '원인준',
    권한: 'ADMIN'
  });

  var 생성ID = null;

  try {

    // 1) 추가
    BASE_add(token, { 구분: '시술명', 값: 'TEST-시술명' });

    var 목록 = BASE_getList(token, { 구분: '시술명' });
    var 추가된 = 목록.filter(function(r) { return r.값 === 'TEST-시술명'; });

    생성ID = 추가된.length ? 추가된[0].기준ID : null;

    Logger.log('1. 추가: ' + (추가된.length === 1 ? '정상 (' + 생성ID + ')' : '실패'));

    // 2) 중복 차단
    var 중복차단 = false;
    try {
      BASE_add(token, { 구분: '시술명', 값: 'TEST-시술명' });
    } catch (e) {
      중복차단 = true;
    }
    Logger.log('2. 중복 차단: ' + (중복차단 ? '정상' : '실패'));

    // 3) 이름변경
    BASE_이름변경(token, { 기준ID: 생성ID, 값: 'TEST-시술명수정' });

    var 변경확인 = BASE_getList(token, { 구분: '시술명' })
      .filter(function(r) { return r.기준ID === 생성ID && r.값 === 'TEST-시술명수정'; });

    Logger.log('3. 이름변경: ' + (변경확인.length === 1 ? '정상' : '실패'));

    // 4) 사용중지 → 기본 목록 제외
    BASE_사용여부변경(token, 생성ID, false);

    var 중지후 = BASE_getList(token, { 구분: '시술명' })
      .filter(function(r) { return r.기준ID === 생성ID; });

    var 포함조회 = BASE_getList(token, { 구분: '시술명', 미사용포함: true })
      .filter(function(r) { return r.기준ID === 생성ID; });

    Logger.log('4. 사용중지: 기본 목록 ' + 중지후.length + '건(0이어야 정상), ' +
      '미사용포함 ' + 포함조회.length + '건(1이어야 정상)');

    // 5) 검증용 값목록에 시딩 데이터 존재 확인
    var 값들 = BASE_값목록_('H003', '시술명');
    Logger.log('5. H003 시술명 값목록: ' + 값들.length + '건, 리쥬란 힐러 포함=' +
      (값들.indexOf('리쥬란 힐러') !== -1));

  } finally {

    // 6) 테스트 행 정리 (시트에서 직접 삭제)
    if (생성ID) {
      var sheet = DB_getSheet('기준정보');
      var lastRow = sheet.getLastRow();

      if (lastRow >= 2) {
        var ids = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
        for (var r = ids.length - 1; r >= 0; r--) {
          if (String(ids[r][0]) === 생성ID) {
            sheet.deleteRow(r + 2);
          }
        }
      }
    }

    AUTH_logout(token);

    Logger.log('6. 테스트 행 정리, 세션 종료');
  }

  Logger.log('=== 기준정보 통합 테스트 종료 ===');
}