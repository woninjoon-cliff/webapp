// =====================================================================
// Base.gs — 기준정보 도메인 서버 함수 (BASE_*)
//
// - 대상 시트: 14_기준정보
// - 시술 등록 드롭다운(시술명 / 담당실장 / 담당원장) 목록을 관리한다
// - 모든 공개 함수는 첫 인자로 세션 토큰을 받는다
// - 병원별 데이터 분리: 목록은 병원별로 따로 관리한다
// - 물리 삭제 없음: 사용여부 토글(논리 삭제)만 제공
// - 값 변경(이름변경)은 과거 시술 기록의 텍스트를 바꾸지 않는다
// =====================================================================


// =====================================================================
// 상수
// =====================================================================

var BASE_구분목록 = ['시술명', '담당실장', '담당원장', '결제수단', '결제조건', '내원경로', '세부', '방문유형'];

var BASE_헤더 = [
  '기준ID',
  '병원ID',
  '구분',
  '값',
  '비고',
  '사용여부',
  '등록일시',
  '수정일시'
];


// =====================================================================
// 세션 확인 (내부 헬퍼)
// =====================================================================

function BASE_세션확인_(token) {

  var session = AUTH_getSession(token);

  if (!session || !session.병원ID) {
    throw new Error('세션이 만료되었습니다. 다시 로그인해주세요.');
  }

  return session;
}


// =====================================================================
// 기준ID 채번 (내부 헬퍼) — M + 6자리, 전 병원 통합. 개수만큼 연속 발급
// =====================================================================

function BASE_새ID목록_(개수) {

  var rows = DB_getAll('기준정보');
  var max = 0;

  rows.forEach(function(row) {
    var id = String(row['기준ID'] || '');
    if (id.charAt(0) === 'M') {
      var n = parseInt(id.substring(1), 10);
      if (!isNaN(n) && n > max) {
        max = n;
      }
    }
  });

  var list = [];

  for (var i = 1; i <= 개수; i++) {
    list.push('M' + ('000000' + (max + i)).slice(-6));
  }

  return list;
}


// =====================================================================
// 목록 조회
//
// 조건 (선택):
// {
//   구분: '시술명' | '담당실장' | '담당원장' | '' (전체),
//   미사용포함: true | false (기본 false — 드롭다운용은 사용중만)
// }
//
// 반환: [{ 기준ID, 구분, 값, 비고, 사용여부 }] — 구분 → 값 가나다 정렬
// =====================================================================

function BASE_getList(token, 조건) {

  var session = BASE_세션확인_(token);

  조건 = 조건 || {};

  var 구분 = String(조건.구분 || '').trim();
  var 미사용포함 = 조건.미사용포함 === true;

  var rows = DB_findWhere('기준정보', { 병원ID: session.병원ID });

  var 결과 = rows
    .filter(function(row) {

      if (구분 && String(row['구분']) !== 구분) {
        return false;
      }

      if (!미사용포함) {
        var 사용 = row['사용여부'];
        if (사용 === false || String(사용).toLowerCase() === 'false') {
          return false;
        }
      }

      return true;
    })
    .map(function(row) {
      var 사용 = row['사용여부'];
      return {
        기준ID: row['기준ID'],
        구분: row['구분'],
        값: String(row['값']),
        비고: String(row['비고'] || ''),
        사용여부: !(사용 === false || String(사용).toLowerCase() === 'false')
      };
    });

  결과.sort(function(a, b) {
    if (a.구분 !== b.구분) {
      return a.구분 < b.구분 ? -1 : 1;
    }
    return a.값.localeCompare(b.값, 'ko');
  });

  return 결과;
}


// =====================================================================
// 항목 추가
// data: { 구분(필수), 값(필수), 비고(선택) }
// - 같은 병원 + 같은 구분 안에서 값 중복 불가 (미사용 항목 포함)
// =====================================================================

function BASE_add(token, data) {

  var session = BASE_세션확인_(token);

  data = data || {};

  var 구분 = String(data.구분 || '').trim();
  var 값 = String(data.값 || '').trim();

  if (BASE_구분목록.indexOf(구분) === -1) {
    throw new Error('구분이 올바르지 않습니다: ' + 구분);
  }

  if (!값) {
    throw new Error('값을 입력해주세요.');
  }

  var 중복 = DB_findWhere('기준정보', { 병원ID: session.병원ID })
    .filter(function(row) {
      return String(row['구분']) === 구분 &&
        String(row['값']).trim() === 값;
    });

  if (중복.length > 0) {
    var 사용 = 중복[0]['사용여부'];
    var 중지됨 = (사용 === false || String(사용).toLowerCase() === 'false');
    throw new Error(
      '이미 등록된 항목입니다: ' + 값 +
      (중지됨 ? ' (사용중지 상태 — 사용재개로 되살릴 수 있습니다)' : '')
    );
  }

  var 지금 = new Date();

  DB_insertMany('기준정보', [{
    기준ID: BASE_새ID목록_(1)[0],
    병원ID: session.병원ID,
    구분: 구분,
    값: 값,
    비고: String(data.비고 || '').trim(),
    사용여부: true,
    등록일시: 지금,
    수정일시: 지금
  }]);

  return { success: true, 값: 값 };
}


// =====================================================================
// 이름변경
// data: { 기준ID(필수), 값(필수) }
// - 과거 시술 기록의 텍스트는 바뀌지 않는다 (기록 보존)
// =====================================================================

function BASE_이름변경(token, data) {

  var session = BASE_세션확인_(token);

  data = data || {};

  var 기준ID = String(data.기준ID || '').trim();
  var 새값 = String(data.값 || '').trim();

  if (!기준ID) {
    throw new Error('기준ID가 없습니다.');
  }

  if (!새값) {
    throw new Error('값을 입력해주세요.');
  }

  var 기존 = DB_findById('기준정보', '기준ID', 기준ID);

  if (!기존) {
    throw new Error('항목을 찾을 수 없습니다: ' + 기준ID);
  }

  if (String(기존['병원ID']) !== String(session.병원ID)) {
    throw new Error('다른 병원의 기준정보는 수정할 수 없습니다.');
  }

  var 중복 = DB_findWhere('기준정보', { 병원ID: session.병원ID })
    .filter(function(row) {
      return String(row['구분']) === String(기존['구분']) &&
        String(row['값']).trim() === 새값 &&
        String(row['기준ID']) !== 기준ID;
    });

  if (중복.length > 0) {
    throw new Error('이미 등록된 항목입니다: ' + 새값);
  }

  DB_updateById('기준정보', '기준ID', 기준ID, {
    값: 새값,
    수정일시: new Date()
  });

  return { success: true };
}


// =====================================================================
// 사용여부 변경 (논리 삭제 / 복구)
// =====================================================================

function BASE_사용여부변경(token, 기준ID, 사용여부) {

  var session = BASE_세션확인_(token);

  기준ID = String(기준ID || '').trim();

  if (!기준ID) {
    throw new Error('기준ID가 없습니다.');
  }

  var 기존 = DB_findById('기준정보', '기준ID', 기준ID);

  if (!기존) {
    throw new Error('항목을 찾을 수 없습니다: ' + 기준ID);
  }

  if (String(기존['병원ID']) !== String(session.병원ID)) {
    throw new Error('다른 병원의 기준정보는 변경할 수 없습니다.');
  }

  var 새값 = 사용여부 === false ? false : true;

  DB_updateById('기준정보', '기준ID', 기준ID, {
    사용여부: 새값,
    수정일시: new Date()
  });

  return { success: true, 사용여부: 새값 };
}


// =====================================================================
// 검증용 값 집합 (서버 내부용 — Procedure.gs가 호출)
// 해당 병원 + 구분의 "사용중" 값 배열을 반환한다
// =====================================================================

function BASE_값목록_(병원ID, 구분) {

  return DB_findWhere('기준정보', { 병원ID: 병원ID })
    .filter(function(row) {
      var 사용 = row['사용여부'];
      return String(row['구분']) === 구분 &&
        !(사용 === false || String(사용).toLowerCase() === 'false');
    })
    .map(function(row) {
      return String(row['값']).trim();
    });
}


