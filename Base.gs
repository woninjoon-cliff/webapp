      ]);
    });
  });

  sheet.getRange(2, 1, 새행.length, BASE_헤더.length).setValues(새행);

  SpreadsheetApp.flush();

  Logger.log(
    '14_기준정보 생성·시딩 완료: 병원 ' + 병원들.length + '곳 x (시술명 ' +
