  var 병원들 = DB_getAll('병원')
    .map(function(row) { return String(row['병원ID']); })
    .filter(function(id) { return id !== '' && id !== 'undefined'; });

  if (병원들.length === 0) {
    throw new Error('01_병원에 병원이 없습니다.');
  }

  // ---------------- 행 생성 ----------------

  var 지금 = new Date();
  var 새행 = [];
  var 순번 = 0;

  병원들.forEach(function(병원ID) {

    시술명들.forEach(function(항목) {
      순번++;
      새행.push([
