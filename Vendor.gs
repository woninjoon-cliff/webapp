// =====================================================================
// Vendor.gs — 거래처 도메인 서버 함수 (VENDOR_*)
//
// - 대상 시트: 04_거래처 (16열)
// - 모든 공개 함수는 첫 인자로 세션 토큰을 받는다
// - 병원별 데이터 분리: 세션 병원ID로만 조회/수정한다. 프론트 값을 신뢰하지 않는다
// - 물리 삭제 없음: 거래여부 토글(논리 삭제)만 제공
// - 결제수단 / 결제조건은 14_기준정보(Base.gs)로 관리하되 목록을 강제하지 않는다
//   목록에 없는 값이 들어오면 저장은 그대로 하고 기준정보에 자동 등록한다
//
// 선행 조건
//   1) Migrate.gs 의 MIG_전체실행() 으로 04_거래처가 16열이어야 한다
//   2) Base.gs 의 BASE_구분목록에 '결제수단', '결제조건' 이 포함돼야 한다
// =====================================================================


// =====================================================================
// 상수
// =====================================================================

var VENDOR_구분_수단 = '결제수단';
var VENDOR_구분_조건 = '결제조건';

var VENDOR_헤더 = [
  '거래처ID', '병원ID', '거래처명', '취급품목', '사업자번호',
  '담당자', '전화번호',
  '결제수단', '결제조건', '은행', '계좌번호', '예금주',
  '메모', '거래여부', '등록일시', '수정일시'
];

/** 사용자가 입력하는 필드 (거래처ID/병원ID/거래여부/일시는 서버가 관리) */
var VENDOR_입력필드 = [
  '거래처명', '취급품목', '사업자번호', '담당자', '전화번호',
  '결제수단', '결제조건', '은행', '계좌번호', '예금주', '메모'
];

var VENDOR_기본_결제수단 = ['계좌이체', '카드', '기타'];

var VENDOR_기본_결제조건 = [
  '즉시결제(온라인)', '당월결제', '당월 26일', '익월 15일', '익월 말일', '익월결제',
  '1주', '1개월', '2개월', '3개월', '6개월', '협의'
];


// =====================================================================
// 내부 헬퍼
// =====================================================================

/** @private */
function VENDOR_세션확인_(token) {

  var session = AUTH_getSession(token);

  if (!session || !session.병원ID) {
    throw new Error('세션이 만료되었습니다. 다시 로그인해주세요.');
  }

  return session;
}

/** @private 문자열 정리 */
function VENDOR_문자열_(v) {
  return String(v === null || v === undefined ? '' : v).trim();
}

/** @private 시트값 -> boolean. 공란은 true(거래중)로 본다 */
function VENDOR_불린_(v) {
  return !(v === false || String(v).toLowerCase() === 'false');
}

/**
 * 거래처ID 채번 — 'V' + 6자리, 전 병원 통합. 개수만큼 연속 발급
 * @private
 */
function VENDOR_새ID목록_(개수) {

  var rows = DB_getAll('거래처');
  var max = 0;

  rows.forEach(function(row) {
    var id = VENDOR_문자열_(row['거래처ID']);
    if (id.charAt(0) === 'V') {
      var n = parseInt(id.substring(1), 10);
      if (!isNaN(n) && n > max) {
        max = n;
      }
    }
  });

  var list = [];

  for (var i = 1; i <= 개수; i++) {
    list.push('V' + ('000000' + (max + i)).slice(-6));
  }

  return list;
}

/**
 * 같은 병원 안에서 거래처명 중복 검사. 거래종료 항목도 대상에 포함한다.
 * @private
 */
function VENDOR_중복확인_(병원ID, 거래처명, 제외거래처ID) {

  var 이름 = 거래처명.toLowerCase();

  return DB_findWhere('거래처', { 병원ID: 병원ID }).some(function(row) {
    if (제외거래처ID && VENDOR_문자열_(row['거래처ID']) === 제외거래처ID) {
      return false;
    }
    return VENDOR_문자열_(row['거래처명']).toLowerCase() === 이름;
  });
}

/**
 * 결제수단 / 결제조건에 새 값이 들어오면 기준정보에 자동 등록한다.
 * 목록을 강제하지 않는 대신 다음 사람이 드롭다운에서 고를 수 있게 한다.
 * 실패해도 거래처 저장은 진행한다 (인증·저장 경로에 새 실패 지점을 만들지 않는다).
 * @private
 */
function VENDOR_기준정보자동등록_(token, 병원ID, 구분, 값) {

  var v = VENDOR_문자열_(값);

  if (!v) {
    return;
  }

  try {

    var 기존 = BASE_값목록_(병원ID, 구분) || [];

    for (var i = 0; i < 기존.length; i++) {
      if (VENDOR_문자열_(기존[i]) === v) {
        return;
      }
    }

    BASE_add(token, { 구분: 구분, 값: v, 비고: '거래처 등록 시 자동 추가' });

  } catch (e) {
    Logger.log('기준정보 자동등록 건너뜀 (' + 구분 + '=' + v + '): ' + e.message);
  }
}

/** @private 시트 행 -> 프론트 객체 */
function VENDOR_행변환_(row) {
  return {
    거래처ID: VENDOR_문자열_(row['거래처ID']),
    거래처명: VENDOR_문자열_(row['거래처명']),
    취급품목: VENDOR_문자열_(row['취급품목']),
    사업자번호: VENDOR_문자열_(row['사업자번호']),
    담당자: VENDOR_문자열_(row['담당자']),
    전화번호: VENDOR_문자열_(row['전화번호']),
    결제수단: VENDOR_문자열_(row['결제수단']),
    결제조건: VENDOR_문자열_(row['결제조건']),
    은행: VENDOR_문자열_(row['은행']),
    계좌번호: VENDOR_문자열_(row['계좌번호']),
    예금주: VENDOR_문자열_(row['예금주']),
    메모: VENDOR_문자열_(row['메모']),
    거래여부: VENDOR_불린_(row['거래여부'])
  };
}


// =====================================================================
// 목록 조회
//
// 조건 (선택): { 거래종료포함: true | false }
//   기본 false — 발주 화면 드롭다운은 거래중만 필요하다
//
// 반환: 거래처ID 오름차순 배열
// =====================================================================

function VENDOR_getList(token, 조건) {

  var session = VENDOR_세션확인_(token);

  조건 = 조건 || {};

  var 거래종료포함 = 조건.거래종료포함 === true;

  var 결과 = DB_findWhere('거래처', { 병원ID: session.병원ID })
    .map(VENDOR_행변환_)
    .filter(function(r) {
      if (!r.거래처ID && !r.거래처명) {
        return false;
      }
      return 거래종료포함 ? true : r.거래여부;
    });

  결과.sort(function(a, b) {
    return a.거래처ID.localeCompare(b.거래처ID);
  });

  return 결과;
}


// =====================================================================
// 등록
// data: VENDOR_입력필드. 거래처명만 필수
// =====================================================================

function VENDOR_add(token, data) {

  var session = VENDOR_세션확인_(token);

  data = data || {};

  var 거래처명 = VENDOR_문자열_(data.거래처명);

  if (!거래처명) {
    throw new Error('거래처명을 입력해주세요.');
  }

  if (VENDOR_중복확인_(session.병원ID, 거래처명, null)) {
    throw new Error('이미 등록된 거래처명입니다: ' + 거래처명);
  }

  var 지금 = new Date();

  var 행 = {
    거래처ID: VENDOR_새ID목록_(1)[0],
    병원ID: session.병원ID,
    거래여부: true,
    등록일시: 지금,
    수정일시: 지금
  };

  VENDOR_입력필드.forEach(function(k) {
    행[k] = VENDOR_문자열_(data[k]);
  });

  DB_insert('거래처', 행);

  VENDOR_기준정보자동등록_(token, session.병원ID, VENDOR_구분_수단, 행.결제수단);
  VENDOR_기준정보자동등록_(token, session.병원ID, VENDOR_구분_조건, 행.결제조건);

  return { success: true, 거래처ID: 행.거래처ID, 거래처명: 거래처명 };
}


// =====================================================================
// 수정
// data: { 거래처ID(필수) } + VENDOR_입력필드
// - 다른 병원 거래처면 서버가 명시적으로 거부한다
// - 거래여부는 여기서 바꾸지 않는다 (VENDOR_거래여부변경 사용)
// =====================================================================

function VENDOR_update(token, data) {

  var session = VENDOR_세션확인_(token);

  data = data || {};

  var 거래처ID = VENDOR_문자열_(data.거래처ID);

  if (!거래처ID) {
    throw new Error('거래처ID가 없습니다.');
  }

  var 대상 = DB_findById('거래처', '거래처ID', 거래처ID);

  if (!대상) {
    throw new Error('거래처를 찾을 수 없습니다: ' + 거래처ID);
  }

  if (VENDOR_문자열_(대상['병원ID']) !== session.병원ID) {
    throw new Error('다른 병원의 거래처는 수정할 수 없습니다.');
  }

  var 거래처명 = VENDOR_문자열_(data.거래처명);

  if (!거래처명) {
    throw new Error('거래처명을 입력해주세요.');
  }

  if (VENDOR_중복확인_(session.병원ID, 거래처명, 거래처ID)) {
    throw new Error('이미 등록된 거래처명입니다: ' + 거래처명);
  }

  var updates = { 수정일시: new Date() };

  VENDOR_입력필드.forEach(function(k) {
    updates[k] = VENDOR_문자열_(data[k]);
  });

  DB_updateById('거래처', '거래처ID', 거래처ID, updates);

  VENDOR_기준정보자동등록_(token, session.병원ID, VENDOR_구분_수단, updates.결제수단);
  VENDOR_기준정보자동등록_(token, session.병원ID, VENDOR_구분_조건, updates.결제조건);

  return { success: true, 거래처ID: 거래처ID };
}


// =====================================================================
// 거래여부 변경 (논리 삭제 / 복구)
// - 물리 삭제 함수는 두지 않는다.
//   행을 지우면 이 거래처를 참조하는 발주·입고·LOT 기록이 깨진다
// =====================================================================

function VENDOR_거래여부변경(token, 거래처ID, 거래여부) {

  var session = VENDOR_세션확인_(token);

  var id = VENDOR_문자열_(거래처ID);

  if (!id) {
    throw new Error('거래처ID가 없습니다.');
  }

  var 대상 = DB_findById('거래처', '거래처ID', id);

  if (!대상) {
    throw new Error('거래처를 찾을 수 없습니다: ' + id);
  }

  if (VENDOR_문자열_(대상['병원ID']) !== session.병원ID) {
    throw new Error('다른 병원의 거래처는 변경할 수 없습니다.');
  }

  DB_updateById('거래처', '거래처ID', id, {
    거래여부: (거래여부 === true),
    수정일시: new Date()
  });

  return { success: true, 거래처ID: id, 거래여부: (거래여부 === true) };
}


// =====================================================================
// 결제수단 / 결제조건 목록 (프론트 드롭다운·datalist용)
// 기준정보에 등록된 값 + 기본 목록을 합쳐 돌려준다
// =====================================================================

function VENDOR_옵션목록(token) {

  var session = VENDOR_세션확인_(token);

  function 합치기(기본, 구분) {

    var 결과 = 기본.slice();

    try {
      (BASE_값목록_(session.병원ID, 구분) || []).forEach(function(v) {
        var s = VENDOR_문자열_(v);
        if (s && 결과.indexOf(s) === -1) {
          결과.push(s);
        }
      });
    } catch (e) {
      Logger.log('기준정보 조회 건너뜀 (' + 구분 + '): ' + e.message);
    }

    return 결과;
  }

  return {
    결제수단: 합치기(VENDOR_기본_결제수단, VENDOR_구분_수단),
    결제조건: 합치기(VENDOR_기본_결제조건, VENDOR_구분_조건)
  };
}


// =====================================================================
// 서버 재검증용 — 거래중 거래처명 목록 (발주 저장 시 대조)
// =====================================================================

function VENDOR_값목록_(병원ID) {

  return DB_findWhere('거래처', { 병원ID: 병원ID })
    .filter(function(row) { return VENDOR_불린_(row['거래여부']); })
    .map(function(row) { return VENDOR_문자열_(row['거래처명']); })
    .filter(function(v) { return v !== ''; });
}


// =====================================================================
// 기준정보 시딩 — 결제수단 3 + 결제조건 12
// 반복 실행 안전 (BASE_add가 중복을 막으므로 예외를 삼킨다)
// =====================================================================

function VENDOR_기준정보시딩(token) {

  var session = VENDOR_세션확인_(token);

  var 추가 = 0;
  var 건너뜀 = 0;

  function 넣기(구분, 값들) {
    값들.forEach(function(v) {
      try {
        BASE_add(token, { 구분: 구분, 값: v, 비고: '' });
        추가++;
      } catch (e) {
        건너뜀++;
      }
    });
  }

  넣기(VENDOR_구분_수단, VENDOR_기본_결제수단);
  넣기(VENDOR_구분_조건, VENDOR_기본_결제조건);

  Logger.log('기준정보 시딩 (' + session.병원ID + '): 추가 ' + 추가 + ' / 기존 ' + 건너뜀);

  return { 병원ID: session.병원ID, 추가: 추가, 건너뜀: 건너뜀 };
}


// =====================================================================
// 거래처 시딩 — 비올라셀_구매총무 시트 추출 57건
//
// 세션 병원ID로 들어간다. 작업 대상 병원은 H003 하나뿐이므로
// H003 계정으로 로그인한 상태의 토큰으로 실행할 것.
// 반복 실행 안전: 이미 같은 이름이 있으면 건너뛴다.
// =====================================================================

function VENDOR_시딩(token) {

  var session = VENDOR_세션확인_(token);

  var 기존이름 = {};

  DB_findWhere('거래처', { 병원ID: session.병원ID }).forEach(function(row) {
    기존이름[VENDOR_문자열_(row['거래처명']).toLowerCase()] = true;
  });

  var 대상 = VENDOR_시딩데이터_().filter(function(d) {
    return !기존이름[VENDOR_문자열_(d.거래처명).toLowerCase()];
  });

  if (대상.length === 0) {
    Logger.log('거래처 시딩: 추가할 항목 없음 (이미 ' + Object.keys(기존이름).length + '건 존재)');
    return { 병원ID: session.병원ID, 추가: 0, 건너뜀: VENDOR_시딩데이터_().length };
  }

  var ids = VENDOR_새ID목록_(대상.length);
  var 지금 = new Date();

  var 행목록 = 대상.map(function(d, i) {

    var 행 = {
      거래처ID: ids[i],
      병원ID: session.병원ID,
      거래여부: d.거래여부 !== false,
      등록일시: 지금,
      수정일시: 지금
    };

    VENDOR_입력필드.forEach(function(k) {
      행[k] = VENDOR_문자열_(d[k]);
    });

    return 행;
  });

  DB_insertMany('거래처', 행목록);

  Logger.log(
    '거래처 시딩 (' + session.병원ID + '): 추가 ' + 행목록.length +
