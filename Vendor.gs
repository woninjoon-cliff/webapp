    ' / ID ' + ids[0] + ' ~ ' + ids[ids.length - 1]
  );

  return {
    병원ID: session.병원ID,
    추가: 행목록.length,
    건너뜀: VENDOR_시딩데이터_().length - 행목록.length
  };
}


// =====================================================================
// ★ 편집기에서 바로 실행하는 시딩 진입점
//
// 편집기에는 세션 토큰이 없으므로 H003 관리자 세션을 내부에서 만든다.
// 함수 드롭다운에서 이것을 골라 실행하면 결제수단·결제조건 기준정보와
// 거래처 57건이 H003에 한 번에 들어간다.
//
// 반복 실행 안전 — 이미 있으면 건너뛴다.
// =====================================================================

function VENDOR_시딩실행_H003() {

  var users = DB_findWhere('사용자', { 병원ID: 'H003', 아이디: 'joon' });

  if (users.length === 0) {
    throw new Error('H003 / joon 계정을 찾을 수 없습니다. 02_사용자 시트를 확인하십시오.');
  }

  var token = AUTH_createSession(users[0]);

  try {

    Logger.log('===== H003 거래처 시딩 시작 =====');

    var 기준 = VENDOR_기준정보시딩(token);
    Logger.log('1) 기준정보: 추가 ' + 기준.추가 + ' / 기존 ' + 기준.건너뜀);

    var 거래처 = VENDOR_시딩(token);
    Logger.log('2) 거래처: 추가 ' + 거래처.추가 + ' / 건너뜀 ' + 거래처.건너뜀);

    var 확인 = VENDOR_getList(token, { 거래종료포함: true });
    var 거래중 = 확인.filter(function(r) { return r.거래여부; }).length;

    Logger.log('3) 확인: 총 ' + 확인.length + '건 (거래중 ' + 거래중 +
               ' · 거래종료 ' + (확인.length - 거래중) + ')');

    if (확인.length > 0) {
      Logger.log('   첫 행: ' + 확인[0].거래처ID + ' ' + 확인[0].거래처명 +
                 ' / ' + 확인[0].취급품목);
      Logger.log('   끝 행: ' + 확인[확인.length - 1].거래처ID + ' ' +
                 확인[확인.length - 1].거래처명);
    }

    Logger.log('===== 시딩 종료 — /dev 새로고침 후 거래처 관리 확인 =====');

    return { 기준정보: 기준, 거래처: 거래처, 총건수: 확인.length };

  } finally {
    AUTH_logout(token);
  }
}


// =====================================================================
// 통합 테스트 (등록 → 조회 → 수정 → 재조회 → 거래종료 → 재개 → 원복)
// 실제 시트에 테스트 행을 남기지 않는다 (마지막에 거래종료 처리)
// =====================================================================

function test_VENDOR_전체흐름() {

  var token = null;

  // 세션 없이 실행되므로 H003 관리자 세션을 직접 만든다
  var users = DB_findWhere('사용자', { 병원ID: 'H003', 아이디: 'joon' });

  if (users.length === 0) {
    throw new Error('H003 / joon 계정을 찾을 수 없습니다.');
  }

  token = AUTH_createSession(users[0]);

  var 이름 = '__테스트거래처__' + new Date().getTime();

  Logger.log('=== 거래처 전체흐름 테스트 시작 (H003) ===');

  // 1) 등록
  var 등록 = VENDOR_add(token, {
    거래처명: 이름,
    취급품목: '테스트품목',
    담당자: '홍길동 과장',
    전화번호: '010-0000-0000',
    결제수단: '계좌이체',
    결제조건: '2개월',
    은행: '국민은행',
    계좌번호: '000-00-0000',
    예금주: '테스트',
    메모: '자동 테스트'
  });
  Logger.log('1. 등록: ' + 등록.거래처ID + ' / ' + 등록.거래처명);

  // 2) 조회
  var 목록 = VENDOR_getList(token, { 거래종료포함: true });
  var 대상 = 목록.filter(function(r) { return r.거래처ID === 등록.거래처ID; })[0];
  if (!대상) { throw new Error('등록한 거래처를 조회하지 못했습니다.'); }
  Logger.log('2. 조회: 총 ' + 목록.length + '건 / 결제조건=' + 대상.결제조건 + ' / 결제수단=' + 대상.결제수단);

  // 3) 중복 차단 확인
  var 중복차단 = false;
  try { VENDOR_add(token, { 거래처명: 이름 }); }
  catch (e) { 중복차단 = true; }
  Logger.log('3. 중복 차단: ' + (중복차단 ? '정상 차단' : '★차단 실패★'));

  // 4) 수정 (목록에 없는 결제조건 -> 기준정보 자동 등록되는지)
  var 새조건 = '__테스트조건__' + new Date().getTime();
  VENDOR_update(token, {
    거래처ID: 등록.거래처ID,
    거래처명: 이름,
    취급품목: '수정품목',
    담당자: '김철수 부장',
    전화번호: '010-1111-1111',
    결제수단: '카드',
    결제조건: 새조건,
    메모: '수정됨'
  });
  Logger.log('4. 수정 완료');

  // 5) 재조회
  목록 = VENDOR_getList(token, { 거래종료포함: true });
  대상 = 목록.filter(function(r) { return r.거래처ID === 등록.거래처ID; })[0];
  Logger.log('5. 재조회: 취급품목=' + 대상.취급품목 + ' / 담당자=' + 대상.담당자 +
             ' / 결제수단=' + 대상.결제수단 + ' / 결제조건=' + 대상.결제조건);

  // 6) 기준정보 자동 등록 확인
  var 조건목록 = VENDOR_옵션목록(token).결제조건;
  Logger.log('6. 결제조건 자동등록: ' + (조건목록.indexOf(새조건) >= 0 ? '정상' : '★미등록★') +
             ' (목록 ' + 조건목록.length + '개)');

  // 7) 거래종료 -> 목록에서 빠지는지
  VENDOR_거래여부변경(token, 등록.거래처ID, false);
  var 거래중목록 = VENDOR_getList(token, {});
  var 남음 = 거래중목록.filter(function(r) { return r.거래처ID === 등록.거래처ID; }).length;
  Logger.log('7. 거래종료: 거래중 목록 잔존 ' + 남음 + '건 (0이어야 정상)');

  // 8) 거래재개
  VENDOR_거래여부변경(token, 등록.거래처ID, true);
  거래중목록 = VENDOR_getList(token, {});
  남음 = 거래중목록.filter(function(r) { return r.거래처ID === 등록.거래처ID; }).length;
  Logger.log('8. 거래재개: 거래중 목록 잔존 ' + 남음 + '건 (1이어야 정상)');

  // 9) 타 병원 접근 차단 확인
  var 차단됨 = false;
  var 타병원 = DB_getAll('거래처').filter(function(row) {
    return VENDOR_문자열_(row['병원ID']) && VENDOR_문자열_(row['병원ID']) !== 'H003';
  })[0];

  if (타병원) {
    try { VENDOR_update(token, { 거래처ID: VENDOR_문자열_(타병원['거래처ID']), 거래처명: '침범시도' }); }
    catch (e) { 차단됨 = true; }
    Logger.log('9. 타 병원 접근: ' + (차단됨 ? '정상 차단' : '★차단 실패★'));
  } else {
    Logger.log('9. 타 병원 접근: 다른 병원 데이터가 없어 건너뜀');
  }

  // 10) 정리 — 테스트 행은 거래종료로 남긴다 (물리 삭제 없음)
  VENDOR_거래여부변경(token, 등록.거래처ID, false);
  AUTH_logout(token);
  Logger.log('10. 정리: 테스트 거래처를 거래종료로 남김 (' + 등록.거래처ID + ')');
  Logger.log('    남은 테스트 행과 기준정보 "' + 새조건 + '"은 수동으로 정리하십시오.');

  Logger.log('=== 거래처 전체흐름 테스트 종료 ===');
}


